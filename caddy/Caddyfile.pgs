{
	storage redis {
		address {$VALKEY_ADDR}
		password "{$VALKEY_PASSWORD}"
		timeout 5
		key_prefix "caddy"
	}
	on_demand_tls {
		ask http://web:3000/check
	}
	servers {
		metrics
		trusted_proxies static 0.0.0.0/0
	}
}

# Metrics routes need ?x-authorization={$METRICS_TOKEN}. An unset token matches
# nothing.
(metrics_token) {
	expression `{http.request.uri.query.x-authorization} == "{$METRICS_TOKEN}" && "{$METRICS_TOKEN}" != ""`
}

# Apps serve metrics on /_metrics, which only the token-checked routes reach.
# Scrapes stay out of the access logs so the token does too.
(block_app_metrics) {
	@appmetrics path /_metrics /_metrics/*
	respond @appmetrics 404
	@metricsroutes path /_caddy/metrics /_ssh/metrics /_web/metrics /_imgproxy/metrics /_app/metrics
	log_skip @metricsroutes
}

# custom domains
:443 {
	import block_app_metrics
	reverse_proxy web:3000
	log {
		format append {
			server_id {$APP_DOMAIN}
		}
	}
	tls {$APP_EMAIL} {
		on_demand
	}
	encode zstd gzip
}

# subdomains and root pgs domain
*.{$APP_DOMAIN}, {$APP_DOMAIN} {
	import block_app_metrics
	reverse_proxy web:3000
	log {
		format append {
			server_id {$APP_DOMAIN}
		}
	}
	tls {$APP_EMAIL} {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	encode zstd gzip

	header {
		# disable FLoC tracking
		?Permissions-Policy interest-cohort=()

		# enable HSTS
		?Strict-Transport-Security max-age=31536000;

		# disable clients from sniffing the media type
		?X-Content-Type-Options nosniff

		# clickjacking protection
		?X-Frame-Options DENY

		# keep referrer data off of HTTP connections
		?Referrer-Policy no-referrer-when-downgrade

		?X-XSS-Protection "1; mode=block"
	}

	@caddymetrics {
		host {$APP_DOMAIN} *.{$APP_DOMAIN}
		path /_caddy/metrics
		import metrics_token
	}

	metrics @caddymetrics {
		disable_openmetrics
	}

	@sshmetrics {
		host {$APP_DOMAIN} *.{$APP_DOMAIN}
		path /_ssh/metrics
		import metrics_token
	}

	handle @sshmetrics {
		rewrite * /metrics
		reverse_proxy ssh:9222
	}

	@webmetrics {
		host {$APP_DOMAIN} *.{$APP_DOMAIN}
		path /_web/metrics
		import metrics_token
	}

	handle @webmetrics {
		rewrite * /_metrics
		reverse_proxy web:3000 {
			header_up Host {$APP_DOMAIN}
		}
	}

	@imgproxymetrics {
		host {$APP_DOMAIN} *.{$APP_DOMAIN}
		path /_imgproxy/metrics
		import metrics_token
	}

	handle @imgproxymetrics {
		rewrite * /metrics
		reverse_proxy imgproxy:8081
	}
}
