{
	servers {
		metrics
	}
}

# Metrics routes need ?x-authorization={$METRICS_TOKEN}. An unset token matches
# nothing.
(metrics_token) {
	expression `{http.request.uri.query.x-authorization} == "{$METRICS_TOKEN}" && "{$METRICS_TOKEN}" != ""`
}

{$APP_DOMAIN} {
	reverse_proxy https://pico-docs-prod.pgs.sh {
		header_up Host pico.sh
	}

	tls {$APP_EMAIL} {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	@caddymetrics {
		host {$APP_DOMAIN}
		path /_caddy/metrics
		import metrics_token
	}

	metrics @caddymetrics {
		disable_openmetrics
	}

	@sshmetrics {
		host {$APP_DOMAIN}
		path /_ssh/metrics
		import metrics_token
	}

	handle @sshmetrics {
		rewrite * /metrics
		reverse_proxy ssh:9222
	}
}
