{
	servers {
		metrics
	}
}

# Metrics routes need ?x-authorization={$METRICS_TOKEN}. An unset token matches
# nothing.
(metrics_token) {
	expression `{http.request.uri.query.x-authorization} == "{$METRICS_TOKEN}" && "{$METRICS_TOKEN}" != ""`
}

# Apps serve metrics on /_metrics, which only the token-checked routes reach.
# Scrapes stay out of the access logs so the token does too.
(block_app_metrics) {
	@appmetrics path /_metrics /_metrics/*
	respond @appmetrics 404
	@metricsroutes path /_caddy/metrics /_ssh/metrics /_web/metrics /_imgproxy/metrics /_app/metrics
	log_skip @metricsroutes
}

*.pico.sh, pico.sh {
	import block_app_metrics
	@auth {
		host auth.pico.sh
	}

	@irc {
		host irc.pico.sh
	}

	@ircmetrics {
		host irc.pico.sh
		path /_app/metrics
		import metrics_token
	}

	@options {
		method OPTIONS
	}
	respond @options 204

	@caddymetrics {
		host auth.pico.sh
		path /_caddy/metrics
		import metrics_token
	}

	metrics @caddymetrics {
		disable_openmetrics
	}

	@webmetrics {
		host auth.pico.sh
		path /_web/metrics
		import metrics_token
	}

	handle @webmetrics {
		rewrite * /_metrics
		reverse_proxy auth-web:3000
	}

	reverse_proxy @auth auth-web:3000

	reverse_proxy @irc https://bouncer:8080 {
		transport http {
			tls_insecure_skip_verify
		}
	}

	handle @ircmetrics {
		rewrite * /metrics
		reverse_proxy bouncer:80
	}

	tls {$APP_EMAIL} {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip

	header {
		# disable FLoC tracking
		Permissions-Policy interest-cohort=()

		# enable HSTS
		Strict-Transport-Security max-age=31536000;

		# disable clients from sniffing the media type
		X-Content-Type-Options nosniff

		# clickjacking protection
		X-Frame-Options DENY

		# keep referrer data off of HTTP connections
		Referrer-Policy no-referrer-when-downgrade

		Content-Security-Policy "default-src 'self'; img-src * 'unsafe-inline'; style-src * 'unsafe-inline'"

		X-XSS-Protection "1; mode=block"

		Access-Control-Allow-Origin "https://chat.pico.sh"

		Access-Control-Allow-Headers "*"
	}
}
