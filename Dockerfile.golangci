# The stock golangci/golangci-lint:v2.15 image ships a golangci-lint binary
# built with go1.27.0, whose runtime intermittently crashes during GC with
# "fatal error: found bad pointer in Go heap". Rebuild the same golangci-lint
# version with the latest go1.27, which does not exhibit the crash.
FROM golang:1.27 AS builder

RUN CGO_ENABLED=0 GOBIN=/usr/bin go install \
    github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0

FROM golangci/golangci-lint:v2.15

COPY --from=builder /usr/bin/golangci-lint /usr/bin/golangci-lint
